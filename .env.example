# Copy to .env.local and fill in values. Never commit .env.local.

# =============================================================================
# Supabase (chainsight-dev project)
# Project ref: uyiabyyovwhciitlzkal
# Region: us-east-2
# =============================================================================
SUPABASE_URL=https://uyiabyyovwhciitlzkal.supabase.co
SUPABASE_ANON_KEY=               # from Supabase dashboard → API
SUPABASE_SERVICE_ROLE_KEY=       # from Supabase dashboard → API (NEVER commit, NEVER expose to browser)
SUPABASE_PROJECT_REF=uyiabyyovwhciitlzkal

# Next.js needs these prefixed
NEXT_PUBLIC_SUPABASE_URL=https://uyiabyyovwhciitlzkal.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # same as SUPABASE_ANON_KEY

# =============================================================================
# Redis (local Docker or Upstash for production)
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# Memgraph (local Docker)
# =============================================================================
MEMGRAPH_URL=bolt://localhost:7687

# =============================================================================
# Math Service
# =============================================================================
MATH_SERVICE_URL=http://localhost:8081

# =============================================================================
# AWS KMS (Phase 0 Week 2+ for envelope encryption)
# =============================================================================
AWS_REGION=us-east-2
AWS_KMS_KEY_ID=                  # leave blank in dev; encryption uses local libsodium fallback

# =============================================================================
# AI providers (BYOK — leave blank to disable LLM features)
# =============================================================================
ANTHROPIC_API_KEY=               # Tier C default: Claude Opus 4.6
OPENAI_API_KEY=                  # optional fallback

# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000
